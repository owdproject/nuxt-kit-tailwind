{
  "name": "@owdproject/nuxt-kit-tailwind",
  "version": "4.0.0-alpha.3",
  "description": "Base Tailwind CSS configuration kit for Open Web Desktop agnostic apps",
  "keywords": [
    "owd-client",
    "owd-kits",
    "owd-modules",
    "tailwind"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "development": "./src/module.ts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./kit/registerTailwindPath": {
      "types": "./dist/kit/registerTailwindPath.d.mts",
      "import": "./dist/kit/registerTailwindPath.mjs",
      "default": "./dist/kit/registerTailwindPath.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "kit/registerTailwindPath": [
        "./src/kit/registerTailwindPath.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare",
    "dev:prepare": "nuxt-module-build build --stub"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.4",
    "@nuxtjs/tailwindcss": "^6.12.2"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.4",
    "@owdproject/core": "^4.0.0-alpha.3",
    "nuxt": "^4.4.4",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@owdproject/core": "^4.0.0-alpha.3",
    "nuxt": "^4.4.4"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
